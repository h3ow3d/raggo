# Database
POSTGRES_DB=rag_flight_lab
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password

# Embedding / generation models (used in later phases)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

GENERATION_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_RUNTIME=cpu

# Seed data sizes
SEED_FLIGHT_COUNT=5000
SEED_LOG_COUNT=50000
SEED_INCIDENT_COUNT=500

# Ingestion (used in later phases)
INGEST_BATCH_SIZE=128
STARTUP_INGEST_LIMIT=2000

# Host-exposed ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Generation tuning
# Wall-clock budget (seconds) for a single /generate call inside the
# generation-model container. Increase on slow CPUs if you see 504s in
# the logs ("generation timed out after Ns"). Keep
# GENERATION_REQUEST_TIMEOUT >= GEN_TIMEOUT_SECONDS.
GEN_TIMEOUT_SECONDS=240
GENERATION_REQUEST_TIMEOUT=240
# Default cap on new tokens per agent turn. Lower on slow CPUs to keep
# responses inside GEN_TIMEOUT_SECONDS; raise on GPU for longer answers.
AGENT_MAX_NEW_TOKENS=256
