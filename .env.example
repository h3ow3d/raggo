# Domain configuration
# Set to "flights" or "support_tickets" (or any custom domain you create)
RAGGO_DOMAIN=flights

# Database
POSTGRES_DB=rag_flight_lab
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password

# Embedding / generation models (used in later phases)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

GENERATION_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_RUNTIME=cpu

# Seed data sizes
SEED_FLIGHT_COUNT=5000
SEED_LOG_COUNT=50000
SEED_INCIDENT_COUNT=500

# Ingestion (used in later phases)
INGEST_BATCH_SIZE=128
STARTUP_INGEST_LIMIT=2000

# Generation timeouts (CPU-friendly defaults). The inner cap
# (GEN_TIMEOUT_SECONDS) must be <= the outer HTTP cap
# (GENERATION_REQUEST_TIMEOUT) so timed-out generations return a clean
# 504 instead of an httpx ReadTimeout in the backend.
GEN_TIMEOUT_SECONDS=300
GENERATION_REQUEST_TIMEOUT=360
# Maximum new tokens the agent asks for per /generate. Lower values
# keep latency low on CPU; raise on GPU.
AGENT_MAX_NEW_TOKENS=256

# Host-exposed ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
